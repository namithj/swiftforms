<?xml version="1.0"?>
<ruleset name="SwiftForms">
    <description>WordPress coding standards for SwiftForms.</description>

    <file>swiftforms.php</file>
    <file>uninstall.php</file>
    <file>includes</file>
    <file>tests</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>

    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="4"/>

    <config name="testVersion" value="8.2-"/>

    <!-- WordPress-Docs is intentionally not used: this codebase follows a
         no-comments-unless-non-obvious style, so docblocks are only added
         where they carry information a signature doesn't already give. -->
    <rule ref="WordPress-Core"/>
    <rule ref="WordPress-Extra"/>
    <rule ref="PHPCompatibilityWP"/>

    <!-- WordPress.NamingConventions.PrefixAllGlobals requires a >=4 char
         prefix; "swf" (3 chars) is a deliberate, verified-unique choice for
         this codebase (a verified-unique prefix for this codebase),
         so the sniff is disabled rather than adopting a padded prefix. -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <severity>0</severity>
    </rule>

    <!-- Namespaced PSR-4 classes: filenames match class names (PascalCase),
         not the procedural class-foo-bar.php convention this sniff expects. -->
    <rule ref="WordPress.Files.FileName">
        <exclude-pattern>*/includes/*</exclude-pattern>
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>

    <!-- Test-harness patterns: simulated requests, direct filesystem fixtures, test doubles sharing a file. -->
    <rule ref="WordPress.NamingConventions.ValidVariableName">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.Security.NonceVerification">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.WP.AlternativeFunctions">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
    <rule ref="Generic.Files.OneObjectStructurePerFile">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
    <rule ref="Squiz.PHP.CommentedOutCode">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
</ruleset>
