<?xml version="1.0"?>
<ruleset name="SwiftForms">
    <description>WordPress coding standards for SwiftForms.</description>

    <file>swiftforms.php</file>
    <file>uninstall.php</file>
    <file>includes</file>
    <file>tests</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/dist/*</exclude-pattern>

    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="4"/>

    <config name="testVersion" value="8.1-"/>

    <rule ref="WordPress-Core"/>
    <rule ref="WordPress-Docs">
        <!-- Test method names are self-documenting; docblocks are only enforced for shipped code. -->
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
    <rule ref="WordPress-Extra"/>
    <rule ref="PHPCompatibilityWP"/>

    <!-- Test files follow the test-class-*.php convention, not class-*.php. -->
    <rule ref="WordPress.Files.FileName">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>

    <!-- Test-harness patterns: PHPMailer camelCase properties, simulated requests,
         direct filesystem fixtures, and test doubles sharing a file. -->
    <rule ref="WordPress.NamingConventions.ValidVariableName">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.Security.NonceVerification">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.WP.AlternativeFunctions">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
    <rule ref="Generic.Files.OneObjectStructurePerFile">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
    <rule ref="Squiz.PHP.CommentedOutCode">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
</ruleset>