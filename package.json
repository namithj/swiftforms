{
	"name": "swiftforms",
	"version": "1.0.0",
	"private": true,
	"description": "Build tooling for the SwiftForms WordPress plugin.",
	"scripts": {
		"build": "wp-scripts build",
		"format": "wp-scripts format",
		"lint:js": "wp-scripts lint-js src --max-warnings=0",
		"start": "wp-scripts start",
		"test": "composer test",
		"test:php": "composer test",
		"test:js": "wp-scripts test-unit-js",
		"wp-env": "cross-env NODE_OPTIONS=--no-network-family-autoselection wp-env",
		"env:start": "cross-env NODE_OPTIONS=--no-network-family-autoselection wp-env start",
		"env:stop": "wp-env stop",
		"env:destroy": "wp-env destroy",
		"makepot": "npm run wp-env -- run cli --env-cwd=wp-content/plugins/swiftforms wp i18n make-pot . languages/swiftforms.pot --exclude=vendor,node_modules,tests,artifacts,bin,build",
		"package:release": "bin/package-release.sh"
	},
	"devDependencies": {
		"@wordpress/env": "^10.39.0",
		"@wordpress/scripts": "^30.24.0",
		"cross-env": "^7.0.3"
	},
	"overrides": {
		"typescript": "5.7.3"
	}
}
